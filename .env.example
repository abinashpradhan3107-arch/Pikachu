# Cortex environment configuration
# Copy this file to .env.local and fill in the values you need.
# All variables are optional for local use; AI features require a key.

# --- Core -------------------------------------------------------------------

# Encrypts saved AI keys and Moodle tokens (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a secret is generated once at .data/app-secret.
APP_SECRET=

# SQLite database file. Defaults to .data/study-assistant.db
DATABASE_PATH=.data/study-assistant.db

# --- AI provider (optional default for all accounts) ------------------------

# OpenAI-compatible API key. LLM_API_KEY is accepted as an alias.
OPENAI_API_KEY=
LLM_API_KEY=

# OpenAI-compatible base URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name available to your key.
OPENAI_MODEL=gpt-4o-mini

# Label shown in the UI: openai, openrouter, groq, ollama, etc.
LLM_PROVIDER=openai

# --- YouTube (optional) -----------------------------------------------------

# YouTube Data API v3 key. Enables AI video recommendations.
# Manual links are verified with oEmbed even without this key.
YOUTUBE_API_KEY=
