{
  "manifest_version": 3,
  "name": "Cortex LMS Sync",
  "version": "2.0.0",
  "description": "Persistent LMS integration for Cortex AI Study Assistant - detects courses, lectures, assignments and syncs to backend",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://iitj-learn.masaischool.com/*",
    "https://moodle.iitj.ac.in/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_title": "Cortex LMS Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://iitj-learn.masaischool.com/*",
        "https://moodle.iitj.ac.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": [
        "https://iitj-learn.masaischool.com/*",
        "https://moodle.iitj.ac.in/*"
      ]
    }
  ]
}
